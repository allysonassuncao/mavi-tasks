VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Drive › Whatsapp (api/_whatsapp.ts): Uazapi e o segredo do worker (o mesmo
# de mavi_private.whatsapp_config). Nunca coloque o token real aqui.
UAZAPI_URL=
UAZAPI_TOKEN=
WHATSAPP_WORKER_SECRET=
# Opcionais: bucket próprio para as mídias, tempo por chamada e tamanho máximo.
GCS_WHATSAPP_BUCKET=
WHATSAPP_WORKER_BUDGET_MS=80000
WHATSAPP_MEDIA_MAX_MB=300

# Social Media › Agendamento: o app do Meta SÓ do Social Media (separado do
# das Campanhas, que usa META_APP_ID/META_APP_SECRET). No app, cadastre o
# redirecionamento <origem>/api/social-media-callback.
SOCIAL_MEDIA_META_APP_ID=
SOCIAL_MEDIA_META_APP_SECRET=
# 32 bytes em base64 (openssl rand -base64 32): lacra os tokens das Páginas.
SOCIAL_MEDIA_TOKEN_KEY=
# Opcionais: Facebook Login for Business (config_id), versão da Graph API,
# permissões pedidas no login e outro endereço de retorno.
SOCIAL_MEDIA_META_CONFIG_ID=
SOCIAL_MEDIA_META_GRAPH_VERSION=v23.0
SOCIAL_MEDIA_META_SCOPE=
SOCIAL_MEDIA_META_REDIRECT_URI=
