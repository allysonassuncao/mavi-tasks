{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/ads-sync.ts": { "maxDuration": 60 },
    "api/drive.ts": { "maxDuration": 300 },
    "api/meta-leadgen.ts": { "maxDuration": 60 },
    "api/social-leads.ts": { "maxDuration": 300 }
  },
  "rewrites": [
    {
      "source": "/api/invite-user",
      "destination": "/api/edge-function?fn=invite-user"
    },
    {
      "source": "/api/user-admin",
      "destination": "/api/edge-function?fn=user-admin"
    },
    {
      "source": "/api/ai",
      "destination": "/api/drive"
    },
    {
      "source": "/api/whatsapp",
      "destination": "/api/drive"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/drive?v1=:path*"
    },
    {
      "source": "/api/mcp",
      "destination": "/api/drive?mcp=1"
    },
    {
      "source": "/api/mavi-mcp/callback",
      "destination": "/api/drive?mcpcb=1"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "/api/drive?wk=1"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/drive?wk=1"
    },
    {
      "source": "/((?!assets/|icons/|favicon.svg|manifest.webmanifest|sw.js).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co https://storage.googleapis.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://storage.googleapis.com https://api.maso.app.br; media-src 'self' blob: https://storage.googleapis.com; frame-src 'self' blob: https://storage.googleapis.com; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ]
}
