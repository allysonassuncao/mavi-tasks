{
  "rule": [
    {
      "action": { "type": "SetStorageClass", "storageClass": "NEARLINE" },
      "condition": {
        "age": 30,
        "matchesPrefix": ["whatsapp/"],
        "matchesStorageClass": ["STANDARD"]
      }
    },
    {
      "action": { "type": "SetStorageClass", "storageClass": "ARCHIVE" },
      "condition": {
        "age": 365,
        "matchesPrefix": ["whatsapp/"],
        "matchesStorageClass": ["NEARLINE"]
      }
    }
  ]
}
